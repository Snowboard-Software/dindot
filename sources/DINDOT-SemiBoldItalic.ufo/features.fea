feature locl {
    script latn;
    language CAT;
    sub l periodcentered' l by periodcentered.loclCAT;
    sub L periodcentered' L by periodcentered.loclCAT.case;
} locl;
feature ccmp {
    sub dotlessi dotaccentcmb by idotaccent;
} ccmp;

@DindotAboveMarks = [gravecomb acutecomb circumflexcmb tildecomb macroncmb brevecmb dotaccentcmb dieresiscmb ringcmb hungarumlautcmb caroncmb commaturnedabovecmb hookabovecomb];
feature ccmp {
  sub i' @DindotAboveMarks by i.dotless;
  sub j' @DindotAboveMarks by j.dotless;
  sub iogonek' @DindotAboveMarks by iogonek.dotless;
  sub iukrcyr' @DindotAboveMarks by iukrcyr.dotless;
  sub jecyr' @DindotAboveMarks by jecyr.dotless;
  sub uni1D62' @DindotAboveMarks by uni1D62.dotless;
  sub idotbelow' @DindotAboveMarks by idotbelow.dotless;
  sub uni2071' @DindotAboveMarks by uni2071.dotless;
  sub uni2C7C' @DindotAboveMarks by uni2C7C.dotless;
} ccmp;

table GDEF {
  LigatureCaretByPos fi 589;
  LigatureCaretByPos fl 634;
  LigatureCaretByPos t_t 680;
  LigatureCaretByPos onequarter 537 1075;
  LigatureCaretByPos onehalf 534 1068;
  LigatureCaretByPos threequarters 600 1200;
} GDEF;

